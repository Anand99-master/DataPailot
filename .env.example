# ==============================================================================
# DATAPILOT ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Copy this file to .env for local development. Never commit .env or production secrets.
# ==============================================================================

# Application (Optional / Development defaults)
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# AI Services (Optional in development / preview)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# PRODUCTION & STAGING INFRASTRUCTURE VARIABLES (Uncomment only in production/staging)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_POOL_SIZE=20
# DB_CONNECTION_TIMEOUT=5000
# SESSION_SECRET=your-secure-session-secret-here
# SESSION_TIMEOUT=86400000
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=datapilot-storage-bucket
# JOB_CONCURRENCY=5
# LOG_LEVEL=info

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL CONFIGURATION (Phase 3.3)
# ------------------------------------------------------------------------------
# Provider choice: 'resend' or 'smtp' (falls back to development mode if unset)
EMAIL_PROVIDER=resend
EMAIL_FROM="DataPilot <notifications@datapilot.io>"
EMAIL_REPLY_TO="support@datapilot.io"

# Resend Provider configuration (when EMAIL_PROVIDER=resend)
EMAIL_API_KEY=

# SMTP Provider configuration (when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SMTP_SECURE=false

