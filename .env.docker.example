# Docker-only environment. Copy to .env.docker and set local secret values.
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

POSTGRES_DB=datapilot_prod
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://datapilot:replace-with-a-local-password@postgres:5432/datapilot_prod
SESSION_SECRET=replace-with-a-long-random-local-secret

GEMINI_API_KEY=
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=5000
STORAGE_PROVIDER=local
JOB_CONCURRENCY=5
LOG_LEVEL=info