{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/runAllTests.ts",
    "test:adapters": "tsx tests/runDatabaseAdapterTests.ts",
    "test:dialect": "tsx tests/testPhase12Matrix.ts",
    "test:security": "tsx tests/testSqlSecurity.ts",
    "test:schema": "tsx tests/testSchemaAndGrounding.ts",
    "test:lineage": "tsx tests/testDataLineage.ts",
    "test:analysis": "tsx tests/testDashboardAndFilters.ts",
    "test:all": "tsx tests/runAllTests.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^1.44.0",
    "motion": "^12.23.24",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.4",
    "oracledb": "^7.0.1",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-flow-renderer": "^10.3.17",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.14.0",
    "@types/oracledb": "^7.0.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
